    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "did-jwt": "^8.0.18",
    "did-resolver": "^4.1.0",
    "dotenv": "^18.0.7",
    "ethers": "^6.17.0",
    "express": "^5.3.0",
    "file-type": "^22.3.0",
    "image-size": "^2.1.0",
    "key-did-resolver": "^4.0.0",
    "mammoth": "^1.13.0",
