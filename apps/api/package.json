{
  "name": "@tracechain/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "test:orders": "vitest run src/modules/orders",
    "dev": "tsx watch src/server.ts",
