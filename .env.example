# Shared frontend and API configuration
VITE_API_BASE_URL=http://localhost:3000
# Public HTTPS origin encoded into product and receipt QRs. Localhost HTTP is development-only.
VITE_PUBLIC_APP_URL=http://localhost:5173

PORT=3000
FRONTEND_URL=http://localhost:5173
NODE_ENV=development
SIWE_DOMAIN=localhost:5173
SIWE_URI=http://localhost:5173
CHAIN_ID=11155111
CHAIN_NAME=Sepolia
CHAIN_RPC_URL=https://example.invalid/sepolia
CHAIN_CURRENCY_SYMBOL=ETH
# Isolate Sepolia workflows, DIDComm agents and issuer files; existing local files stay intact.
TRACECHAIN_DATA_DIR=.tracechain/sepolia
AUTH_COOKIE_NAME=tracechain_session
AUTH_SESSION_TTL_SECONDS=28800

# Filled by npm run deploy:sepolia after verifying the completed Sepolia suite.
STAKEHOLDER_REGISTRY_ADDRESS=0xaC363700F78C82d95c1aAF63D3ECf97530F4c803
CREDENTIAL_REGISTRY_ADDRESS=0x4771A19Ddf00D372ca153e95F090D19bA53D149c
EVIDENCE_REGISTRY_ADDRESS=0xca790e9C3AC1ac68Bd5838746C407DF324BAfc05
INGREDIENT_REGISTRY_ADDRESS=0x79A841618Fd1C266b2A10A612cA8Be9514ABE5B5
PRODUCT_REGISTRY_ADDRESS=0x648d82D23580E4AEd724408CD09cBD87D20c2475
CUSTODY_TRANSFER_ADDRESS=0x2FD47E91a89b18e26ae8C396E12Ce4126d74C728
SUPPLY_ORDERS_ADDRESS=0xd9ca63f71e35d73Ef35bACb309F780DEcFB8e6f5

# SSI and Hardhat reuse CHAIN_RPC_URL when CHAIN_ID=11155111.
# For local contract testing only, configure a separate SEPOLIA_RPC_URL for did:ethr resolution.
# Configure SEPOLIA_PRIVATE_KEY through the Hardhat keystore, not in this example.
VERAMO_KMS_SECRET_KEY=replace-with-a-64-character-hexadecimal-key
TRACECHAIN_AUTHORITY_DID_ALIAS=tracechain-authority
# Read from StakeholderRegistry.administrator() by configure:sepolia.
BOOTSTRAP_ADMIN_WALLET=

# Encrypted Company Role Credential storage
IPFS_PINNING_API_URL=https://example.invalid/pinning/pinFileToIPFS
IPFS_GATEWAY_URL=https://gateway.pinata.cloud/ipfs
IPFS_PINNING_TOKEN=replace-with-a-scoped-pinning-token
IPFS_ENCRYPTION_KEY=replace-with-a-64-character-hexadecimal-key
