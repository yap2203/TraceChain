# Shared frontend and API configuration
VITE_API_BASE_URL=http://localhost:3000
# Public HTTPS origin encoded into product and receipt QRs. Localhost HTTP is development-only.
VITE_PUBLIC_APP_URL=http://localhost:5173

PORT=3000
FRONTEND_URL=http://localhost:5173
NODE_ENV=development
SIWE_DOMAIN=localhost:5173
SIWE_URI=http://localhost:5173
CHAIN_ID=11155111
CHAIN_NAME=Sepolia
# Legacy/single-provider URL. It remains the browser-visible MetaMask network URL,
# so do not put an unrestricted private provider key here.
CHAIN_RPC_URL=https://example.invalid/sepolia
# Backend-only multi-RPC endpoints. These values are never exposed through Vite.
CHAIN_RPC_PRIMARY_URL=https://eth-sepolia.g.alchemy.com/v2/<ALCHEMY_KEY>
CHAIN_RPC_SECONDARY_URL=https://sepolia.infura.io/v3/<INFURA_KEY>
CHAIN_RPC_EMERGENCY_URL=
CHAIN_LOG_RPC_URL=https://sepolia.infura.io/v3/<INFURA_KEY>
CHAIN_LOG_FALLBACK_URL=
CHAIN_CURRENCY_SYMBOL=ETH
# Set automatically by configure:sepolia from the verified registry creation receipt.
# Keep empty for automatic discovery; never set later than this suite's first deployment.
CHAIN_EVENT_START_BLOCK=
# Incremental event/RPC performance controls. Use 0 confirmations for local Hardhat only.
CHAIN_EVENT_CONFIRMATIONS=2
CHAIN_EVENT_PAGE_SIZE=5000
CHAIN_EVENT_FALLBACK_PAGE_SIZE=10
RPC_READ_CONCURRENCY=4
# Keep below RPC_READ_CONCURRENCY so authentication/normal reads retain capacity.
RPC_BULK_READ_CONCURRENCY=2
# Expensive event/log queries need additional pacing on limited RPC plans.
RPC_BULK_MIN_REQUEST_INTERVAL_MS=1000
# Sepolia-only read aggregation using the code-pinned existing Multicall3 deployment.
RPC_MULTICALL_ENABLED=true
# Use 1 for endpoints with restrictive batch limits; increase only with provider support.
RPC_BATCH_MAX_COUNT=1
RPC_BATCH_STALL_TIME_MS=10
RPC_MIN_REQUEST_INTERVAL_MS=100
RPC_READ_MAX_RETRIES=1
RPC_RETRY_BASE_DELAY_MS=1000
RPC_ENDPOINT_COOLDOWN_MS=30000
RPC_REQUEST_TIMEOUT_MS=15000
OPERATIONAL_READ_CONCURRENCY=8
# Isolate Sepolia workflows, DIDComm agents and issuer files; existing local files stay intact.
TRACECHAIN_DATA_DIR=.tracechain/sepolia
AUTH_COOKIE_NAME=tracechain_session
AUTH_SESSION_TTL_SECONDS=28800

# Filled by npm run deploy:sepolia after verifying the completed Sepolia suite.
STAKEHOLDER_REGISTRY_ADDRESS=0xb76928E7E966D7B69f956A6Daf669b5bA58cC033
CREDENTIAL_REGISTRY_ADDRESS=0x416C47bB4529Ea3Ef826Cb38DeB70a508557cd3f
EVIDENCE_REGISTRY_ADDRESS=0xBFe8d31edd65bd4C6Af617996A3Bf78ca29B107c
INGREDIENT_REGISTRY_ADDRESS=0x4329e4dfA3B9715B1c15A6fB7e042fC122Da81fb
PRODUCT_REGISTRY_ADDRESS=0xb94484210804121E6E3259134E84205A9B9eeF1e
CUSTODY_TRANSFER_ADDRESS=0xBE1AbCC85Bda973f9479d0B37300aD72c8c9112B
SUPPLY_ORDERS_ADDRESS=0xC8e95eDf50ead1F1c26e69FA0bb4A452de69e6Dc
COMPANY_PROOF_REGISTRY_ADDRESS=0xb13F36F9062100c442fdE154097AA16cbD98D94A

# SSI and Hardhat reuse CHAIN_RPC_URL when CHAIN_ID=11155111.
# For local contract testing only, configure a separate SEPOLIA_RPC_URL for did:ethr resolution.
# Configure SEPOLIA_PRIVATE_KEY through the Hardhat keystore, not in this example.
# Required backend startup secret. Restore the original value for existing encrypted Veramo keys.
# Supply through protected process variables or ignored apps/api/.env.runtime (never VITE_).
VERAMO_KMS_SECRET_KEY=replace-with-a-64-character-hexadecimal-key
TRACECHAIN_AUTHORITY_DID_ALIAS=tracechain-authority
# Read from StakeholderRegistry.administrator() by configure:sepolia.
BOOTSTRAP_ADMIN_WALLET=

# Encrypted Company Role Credential storage
IPFS_PINNING_API_URL=https://example.invalid/pinning/pinFileToIPFS
IPFS_GATEWAY_URL=https://gateway.pinata.cloud/ipfs
IPFS_PINNING_TOKEN=replace-with-a-scoped-pinning-token
# Required backend startup secret. Keep the original value to decrypt existing IPFS/DIDComm records.
# Exactly 64 hexadecimal characters; no 0x prefix. Never expose it to the browser.
IPFS_ENCRYPTION_KEY=replace-with-a-64-character-hexadecimal-key
